def vps_status_text():
    """采集 VPS 实时资源与关键服务状态。"""
    cpu = psutil.cpu_percent(interval=0.3)
    mem = psutil.virtual_memory()
    swap = psutil.swap_memory()
    disk = psutil.disk_usage("/")

    current = datetime.now(LOCAL_TZ)
    boot = datetime.fromtimestamp(
        psutil.boot_time(), tz=timezone.utc
    ).astimezone(LOCAL_TZ)

    uptime = timedelta(
        seconds=max(0, int(time.time() - psutil.boot_time()))
    )
    uptime_text = (
        f"{uptime.days}天"
        f"{uptime.seconds // 3600}小时"
        f"{(uptime.seconds % 3600) // 60}分钟"
    )

    services = [
        ("echomate-server.service", "Echo-Mate Server"),
        ("echomate-feishu-bot.service", "飞书机器人"),
        ("echomate-monitor.service", "VPS 监控"),
    ]

    lines = [
        "🖥 VPS 实时状态报告",
        f"主机：{os.uname().nodename}",
        f"报告时间（北京时间）：{current:%Y-%m-%d %H:%M:%S}",
        f"系统最近启动：{boot:%Y-%m-%d %H:%M:%S}",
        f"运行时间：{uptime_text}",
        "",
        f"CPU：{cpu:.1f}%（{psutil.cpu_count()} 个逻辑核）",
        (
            f"内存：总计 {mem.total / 1024**3:.2f} GiB，"
            f"可用 {mem.available / 1024**3:.2f} GiB，"
            f"使用率 {mem.percent:.1f}%"
        ),
        (
            f"Swap：已使用 {swap.used / 1024**3:.2f} / "
            f"{swap.total / 1024**3:.2f} GiB"
        ),
        (
            f"磁盘 /：剩余 {disk.free / 1024**3:.2f} / "
            f"{disk.total / 1024**3:.2f} GiB，"
            f"使用率 {disk.percent:.1f}%"
        ),
        "",
        "关键服务状态：",
    ]

    for unit, label in services:
        try:
            result = subprocess.run(
                ["systemctl", "is-active", unit],
                capture_output=True,
                text=True,
                timeout=3,
                check=False,
            )
            state = result.stdout.strip() or "unknown"
        except (OSError, subprocess.TimeoutExpired):
            state = "检查失败"

        lines.append(f"{label}：{state}")

    return "\n".join(lines)


def handle_command(conn, text, chat_id):
    # Exact menu command mapping
    text = {
        "1": "检查 VPS",
        "2": "我的待办",
        "3": "添加待办",
        "4": "列出记忆",
        "5": "帮助",
    }.get(text, text)
    text = text.strip()

    if text in {"检查 VPS", "检查VPS", "VPS 状态", "VPS状态", "服务器状态"}:
        return vps_status_text()

    if text in {"菜单", "功能"}:
        return menu_text()

    if text == "帮助":
        return help_text()

    # -------- 创建待办 --------

    if text in {"添加待办", "新建待办"}:
        return (
            "请按以下格式发送：\\n"
            "添加待办 YYYY-MM-DD HH:MM 事项内容\\n"
            "例如：添加待办 2026-10-20 15:00 检查项目"
        )

    match = re.match(
        r"^添加待办\s+(\d{4}-\d{2}-\d{2})\s+"
        r"(\d{2}:\d{2})\s+(.+)$",
        text,
        re.DOTALL,
    )

    if match:
        date_text, time_text, title = match.groups()
        title = title.strip()

        if not title:
            return "待办标题不能为空。"

        if len(title) > 200:
            return "待办标题最多 200 个字符。"

        try:
            due_local = datetime.strptime(
                f"{date_text} {time_text}",
                "%Y-%m-%d %H:%M",
            ).replace(tzinfo=LOCAL_TZ)
        except ValueError:
            return (
                "日期或时间格式不正确。\n"
                "正确示例：添加待办 2026-10-18 15:00 检查 VPS"
            )

        if due_local <= datetime.now(LOCAL_TZ):
            return "截止时间必须晚于当前时间，请重新设置。"

        due_utc = due_local.astimezone(timezone.utc).isoformat(
            timespec="seconds"
        )

        cursor = conn.execute(
            """
            INSERT INTO todos
                (owner_id, title, due_at_utc, timezone,
                 status, created_at_utc, chat_id)
            VALUES (?, ?, ?, ?, 'pending', ?, ?)
            """,
            (
                OWNER_OPEN_ID,
                title,
                due_utc,
                "Asia/Shanghai",
                now_utc(),
                chat_id,
            ),
        )

        return (
            f"✅ 待办创建成功，编号 #{cursor.lastrowid}\n"
            f"事项：{title}\n"
            f"时间：{due_local.strftime('%Y-%m-%d %H:%M')}\n"
            "到期后将通过飞书提醒你。"
        )

    # -------- 查询待办 --------

    if text in {"我的待办", "待办列表", "查看待办"}:
        rows = conn.execute(
            """
            SELECT id, title, due_at_utc
            FROM todos
            WHERE owner_id = ? AND status = 'pending'
            ORDER BY due_at_utc ASC
            LIMIT 20
            """,
            (OWNER_OPEN_ID,),
        ).fetchall()

        if not rows:
            return "目前没有未完成的待办。"

        lines = ["📋 未完成的待办（最多显示 20 条）："]

        for todo_id, title, due_utc in rows:
            lines.append(
                f"\n#{todo_id}｜{format_due(due_utc)}｜{title}"
            )

        return "\n".join(lines)

    # -------- 完成或取消待办 --------

    match = re.match(
        r"^(完成待办|取消待办)\s*[:：#]?\s*(\d+)\s*$",
        text,
    )

    if match:
        action, todo_id_text = match.groups()
        todo_id = int(todo_id_text)

        new_status = "completed" if action == "完成待办" else "cancelled"

        cursor = conn.execute(
            """
            UPDATE todos
            SET status = ?
            WHERE id = ? AND owner_id = ? AND status = 'pending'
            """,
            (new_status, todo_id, OWNER_OPEN_ID),
        )

        if cursor.rowcount:
            if action == "完成待办":
                return f"✅ 待办 #{todo_id} 已标记为完成。"
            return f"✅ 待办 #{todo_id} 已取消。"

        return (
            f"没有找到编号为 #{todo_id} 的未完成待办。"
            "它可能不存在，或已经完成、取消。"
        )

    # -------- 保存记忆 --------

    match = re.match(
        r"^(?:记住|保存记忆)\s*[:：]\s*(.+)$",
        text,
        re.DOTALL,
    )

    if match:
        content = match.group(1).strip()

        if not content:
            return "记忆内容不能为空。"

        if len(content) > 2000:
            return "单条记忆最多 2000 个字符，请缩短后重试。"

        cursor = conn.execute(
            """
            INSERT INTO memories (owner_id, content, created_at)
            VALUES (?, ?, ?)
            """,
            (OWNER_OPEN_ID, content, now_utc()),
        )

        return (
            f"✅ 记忆已保存，编号 #{cursor.lastrowid}。\n"
            f"内容：{content[:150]}"
        )

    # -------- 搜索记忆 --------

    match = re.match(
        r"^(?:查记忆|搜索记忆)\s*[:：]?\s*(.+)$",
        text,
        re.DOTALL,
    )

    if match:
        keyword = match.group(1).strip()

        rows = conn.execute(
            """
            SELECT id, content
            FROM memories
            WHERE owner_id = ? AND content LIKE ?
            ORDER BY id DESC
            LIMIT 10
            """,
            (OWNER_OPEN_ID, f"%{keyword}%"),
        ).fetchall()

        if not rows:
            return f"没有找到包含“{keyword}”的记忆。"

        lines = [f"🔎 找到 {len(rows)} 条相关记忆："]
        lines.extend(
            f"\n#{row[0]}：{row[1][:180]}"
            for row in rows
        )
        return "\n".join(lines)

    # -------- 列出记忆 --------

    if text in {"列出记忆", "我的记忆", "记忆列表"}:
        rows = conn.execute(
            """
            SELECT id, content
            FROM memories
            WHERE owner_id = ?
            ORDER BY id DESC
            LIMIT 10
            """,
            (OWNER_OPEN_ID,),
        ).fetchall()

        if not rows:
            return "目前还没有保存任何记忆。"

        lines = ["📚 最近的记忆（最多 10 条）："]
        lines.extend(
            f"\n#{row[0]}：{row[1][:180]}"
            for row in rows
        )
        return "\n".join(lines)

    # -------- 删除记忆 --------

    match = re.match(
        r"^删除记忆\s*[:：#]?\s*(\d+)\s*$",
        text,
    )

    if match:
        memory_id = int(match.group(1))

        cursor = conn.execute(
            """
            DELETE FROM memories
            WHERE id = ? AND owner_id = ?
            """,
            (memory_id, OWNER_OPEN_ID),
        )

        if cursor.rowcount:
            return f"✅ 记忆 #{memory_id} 已删除。"

        return f"没有找到编号为 #{memory_id} 的记忆。"

    return None


