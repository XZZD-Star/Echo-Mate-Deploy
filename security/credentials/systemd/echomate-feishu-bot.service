[Unit]
Description=Echo-Mate Feishu Personal Assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/echomate-deploy/feishu_bot
ExecStart=/root/echomate-deploy/feishu-venv/bin/python /root/echomate-deploy/feishu_bot/bot.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/echomate-deploy/shared
LoadCredential=lark_app_id:/etc/echomate/credentials/lark_app_id
LoadCredential=lark_app_secret:/etc/echomate/credentials/lark_app_secret
LoadCredential=lark_owner_open_id:/etc/echomate/credentials/lark_owner_open_id
LoadCredential=dashscope_api_key:/etc/echomate/credentials/dashscope_api_key
LoadCredential=tavily_api_key:/etc/echomate/credentials/tavily_api_key

[Install]
WantedBy=multi-user.target
