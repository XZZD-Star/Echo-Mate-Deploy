[Unit]
Description=Echo-Mate VPS Resource and Service Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/echomate-deploy/monitor
ExecStart=/root/echomate-deploy/feishu-venv/bin/python /root/echomate-deploy/monitor/monitor.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/echomate-deploy/shared
LoadCredential=lark_app_id:/etc/echomate/credentials/lark_app_id
LoadCredential=lark_app_secret:/etc/echomate/credentials/lark_app_secret
LoadCredential=lark_owner_open_id:/etc/echomate/credentials/lark_owner_open_id
UMask=0077

[Install]
WantedBy=multi-user.target
