[Unit]
Description=Echo-Mate AIChat Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/echomate-deploy/app/Demo/AIChat_demo/Server
ExecStart=/root/echomate-deploy/venv/bin/python /root/echomate-deploy/app/Demo/AIChat_demo/Server/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/echomate-deploy/shared
LoadCredential=dashscope_api_key:/etc/echomate/credentials/dashscope_api_key

[Install]
WantedBy=multi-user.target
