[Unit]
Description=Echo-Mate SSH Session Notification Watcher
After=network-online.target echomate-monitor.service
Wants=network-online.target
Requires=echomate-monitor.service

[Service]
Type=simple
WorkingDirectory=/root/echomate-deploy/monitor
ExecStart=/root/echomate-deploy/feishu-venv/bin/python /root/echomate-deploy/monitor/ssh_session_watch.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/echomate-deploy/shared
LoadCredential=lark_app_id:/etc/echomate/credentials/lark_app_id
LoadCredential=lark_app_secret:/etc/echomate/credentials/lark_app_secret
LoadCredential=lark_owner_open_id:/etc/echomate/credentials/lark_owner_open_id

[Install]
WantedBy=multi-user.target
